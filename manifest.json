{
  "manifest_version": 3,
  "name": "VisualCompare Live - Dual Site Compare & Click Sync",
  "version": "1.0.0",
  "description": "Live side-by-side visual regression testing with mirrored clicking, synchronized scrolling, split swipe curtain, and real-time diff overlays.",
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "tabs",
    "scripting",
    "debugger"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_unframe",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["sync_agent.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "sync_agent.js",
        "demo_prod.html",
        "demo_prod_features.html",
        "demo_prod_pricing.html",
        "demo_stg.html",
        "demo_stg_features.html",
        "demo_stg_pricing.html",
        "icons/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
